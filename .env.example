# Local build/development settings. Copy to .env; never commit the populated file.
# Plain KEY=value syntax, no quotes. Escape backslashes as \\ (Java Properties).
# Prefer forward slashes in paths. Never pass this entire file to --dart-define.
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
TV_ADB_SERIAL=
PHONE_ADB_SERIAL=
PREVIEW_DOWNLOAD_DIR=
PRIVATE_AUDIT_DIR=
# Optional public build settings: register your own services/clients.
PAIR_RELAY_BASE=
TRAKT_CLIENT_ID=
SIMKL_CLIENT_ID=
TRAKT_REDIRECT_URI=

# Optional offline audit paths (never include their datasets in a release).
PRIVATE_DISCOVERY_PLAYLIST_FILE=
PRIVATE_DISCOVERY_GUIDE_FILE=
PRIVATE_DISCOVERY_REPORT=
PRIVATE_MOTORSPORT_PLAYLIST_FILE=
PRIVATE_MOTORSPORT_GUIDE_FILE=
PRIVATE_MOTORSPORT_CALENDAR_FILE=
PRIVATE_MOTORSPORT_REPORT=
PRIVATE_COVERAGE_PLAYLIST_FILE=
PRIVATE_COVERAGE_GUIDE_FILE=
PRIVATE_COVERAGE_CALENDAR_FILE=
PRIVATE_COVERAGE_REPORT=
PRIVATE_TENNIS_GUIDE_FILE=
PRIVATE_TENNIS_SCORES_FILE=
PRIVATE_TENNIS_PLAYLIST_FILE=
PRIVATE_TENNIS_REPORT=
